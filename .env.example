# ===== LLM =====
XRAGENT_LLM_PROVIDER=mock              # openai / deepseek / glm / mock
XRAGENT_LLM_MODEL=gpt-4o-mini
XRAGENT_LLM_TEMPERATURE=0.2
XRAGENT_LLM_MAX_TOKENS=4096

# OpenAI-compatible 协议
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# GLM (智谱)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== 父母通道 =====
XRAGENT_HITL_DEFAULT=interactive       # interactive / approve-all / reject-all
XRAGENT_HTTP_HOST=127.0.0.1
XRAGENT_HTTP_PORT=10086
XRAGENT_HTTP_TOKEN=                    # 空 = 不鉴权；非空 = Bearer token

# ===== 成长开关 =====
XRAGENT_EVOLUTION_ENABLED=true         # false = 冻结蜕皮 + terminate

# ===== Watchdog =====
XRAGENT_HEARTBEAT_INTERVAL_S=10
XRAGENT_HEARTBEAT_TIMEOUT_S=60
XRAGENT_RESTART_MAX_FAILURES=5

# ===== 上下文预算 =====
XRAGENT_CONTEXT_BUDGET_TOKENS=20000
XRAGENT_COMPRESS_TARGET_RATIO=0.7

# ===== 测试用（pytest 自动注入；非测试不要设）=====
# XRAGENT_TEST_SRC=/abs/path/to/XRAgent/src
# XRAGENT_TEST_REPO=/tmp/test-repo
