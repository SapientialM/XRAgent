#!/usr/bin/env bash
# 跑 pytest 全套
set -e

if command -v python3.11 >/dev/null 2>&1; then
  PY=python3.11
else
  PY=python3
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"
export PYTHONPATH="$REPO_ROOT/src:${PYTHONPATH:-}"

cd "$REPO_ROOT"
exec "$PY" -m pytest tests/ "$@"
