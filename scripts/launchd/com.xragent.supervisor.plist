<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xragent.supervisor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3.11</string>
        <string>-u</string>
        <string>-m</string>
        <string>xragent.watchdog.supervisor</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/cm/Work/WorkSpace/XRAgent</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/cm/Work/WorkSpace/XRAgent/src</string>
        <key>XRAGENT_LLM_PROVIDER</key>
        <string>minimaxi</string>
        <key>XRAGENT_HEARTBEAT_INTERVAL_S</key>
        <string>10</string>
        <key>XRAGENT_HEARTBEAT_TIMEOUT_S</key>
        <string>60</string>
        <key>XRAGENT_RESTART_MAX_FAILURES</key>
        <string>10</string>
        <key>XRAGENT_EVOLUTION_ENABLED</key>
        <string>true</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/cm/Work/WorkSpace/XRAgent/logs/supervisor.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/cm/Work/WorkSpace/XRAgent/logs/supervisor.err.log</string>
</dict>
</plist>
